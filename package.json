{
  "name": "sentinelprint",
  "version": "0.1.0",
  "private": true,
  "description": "SentinelPrint — multi-tenant printer security auditing SaaS (non-destructive assessment, one-time audits + monthly monitoring subscriptions).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "scan:cli": "tsx scripts/scan-cli.ts",
    "agent": "tsx agent/collector.ts",
    "worker": "tsx worker/index.ts",
    "build:collector": "esbuild agent/collector.ts --bundle --platform=node --target=node18 --outfile=dist/collector.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "bullmq": "^5.34.5",
    "clsx": "2.1.1",
    "ioredis": "^5.4.2",
    "jose": "5.9.6",
    "lucide-react": "0.468.0",
    "net-snmp": "3.20.0",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "17.5.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "8.4.49",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
