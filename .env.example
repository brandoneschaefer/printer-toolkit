# ---- Database ----
# Matches docker-compose.yml below. Change for your own Postgres.
DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinelprint?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Base URL of the app (used for Stripe redirects)
APP_URL="http://localhost:3000"

# ---- Stripe ----
# Create products/prices in the Stripe dashboard, then paste IDs here.
# One-time price = a single on-demand audit. Recurring price = monthly monitoring.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ONE_TIME_AUDIT="price_..."
STRIPE_PRICE_SUBSCRIPTION_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# If true, billing runs in mock mode: purchases are granted instantly without
# contacting Stripe. Useful for local development before Stripe keys exist.
BILLING_MOCK_MODE="true"

# ---- Scanner ----
# Hard safety cap on how many hosts a single audit may probe.
SCANNER_MAX_HOSTS="256"
# Per-port TCP connect timeout (ms).
SCANNER_TCP_TIMEOUT_MS="2500"

# ---- Worker / queue ----
# When set, cloud scans are dispatched to the BullMQ worker over Redis
# (run `npm run worker` in a separate process). When empty, scans run
# in-process and the scheduler only fires if you run the worker anyway.
REDIS_URL=""
# How often the worker checks for due scheduled re-scans (ms).
SCHEDULER_TICK_MS="60000"
